# Copy to .env (never commit .env).

# --- Provider key (LiteLLM reads it) ---
OPENAI_API_KEY=sk-...

# --- Routing: rules (rules_policy.yaml) or static (DEFAULT_CHAIN for every request) ---
ROUTING_POLICY=rules
DEFAULT_CHAIN=gpt-4.1-mini,gpt-5-mini-low,gpt-4.1
REFERENCE_MODEL=gpt-5-medium
# Reference for live web questions (gpt-5-medium cannot search the web)
REFERENCE_SEARCH_MODEL=gpt-5-search

# --- Execution limits ---
PER_CALL_TIMEOUT_S=20
REQUEST_DEADLINE_S=110
MAX_MODEL_CALLS=4
MAX_FALLBACK_HOPS=2
MAX_RETRIES_PER_CALL=1

# --- Request limits and budgets ---
MAX_REQUEST_BYTES=8192
MAX_TOKENS_CAP=1000
MAX_COST_PER_REQUEST_USD=0.05
DAILY_BUDGET_USD=2.00
RATE_LIMIT_PER_MINUTE=10
PER_CLIENT_DAILY_LIMIT=50

# --- Demo mode: scripted answers, no OpenAI calls, no cost (for trying the frontend) ---
DEMO_MODE=false

# --- Frontend address(es) allowed to call the API ---
CORS_ORIGINS=http://localhost:3000

# --- Access control ---
REQUIRE_API_KEY=false
CLIENT_API_KEYS=
# A long random string only you know (admin can force a model). Leave empty to disable.
ADMIN_API_KEYS=
TRUST_PROXY_HEADERS=false

# --- Logging: metadata only. Debug text logging is for local development only ---
DEBUG_LOG_TEXT=false
